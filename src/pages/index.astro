---
import Layout from "../layouts/Layout.astro";
import AboutSection from "../components/AboutSection.astro";
import HeroBackground from "../components/HeroBackground.svelte";
import NavLinks from "../components/NavLinks.svelte";
import Contacts from "../components/Contacts.astro";
import MobileNav from "../components/MobileNav.svelte";
import ProjectsSection from "../components/ProjectsSection.astro";
import hero1536 from "../assets/hero-1536.avif";
import hero2304 from "../assets/hero-2304.avif";
import hero3060 from "../assets/hero.avif";

// Written by scripts/hero-art/upscale.py, smallest first, measured on the long edge
const heroSources = [
    { height: 1536, url: hero1536.src },
    { height: 2304, url: hero2304.src },
    { height: 3060, url: hero3060.src },
];

// Tells a search engine that this site is one person, and which accounts elsewhere are the same
// person. Google reads it for the knowledge panel a name query can show beside the results.
const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Aaron Ye",
    url: "https://aaronye.dev",
    jobTitle: "Software Engineer",
    description:
        "Computer science student at the University of Waterloo who builds full-stack applications with a focus on backend systems.",
    affiliation: {
        "@type": "CollegeOrUniversity",
        name: "University of Waterloo",
        url: "https://uwaterloo.ca/",
    },
    sameAs: [
        "https://github.com/a4ye",
        "https://www.linkedin.com/in/aaron--ye",
        "https://x.com/aaronye1001",
    ],
};
---

<Layout hideHeader>
    <script slot="head" is:inline define:vars={{ sources: heroSources }}>
        /*
         * Choose the hero photo and start fetching it.
         *
         * The shader covers the window with it, and cover-fit means it is sampled at about as many
         * pixels as the canvas is long on its longest side, so anything much larger is downloaded
         * and thrown away. The 1.2 is the liquify pass: it stretches the photo locally, by up to
         * 1.19x at the worst point on the screen, and a texture has to cover that too or those
         * places go soft. The island is the only thing that knows how to draw any of this, but it
         * cannot ask for a file until its own script has been fetched and run, about 290 ms in. So
         * the choosing and the asking happen here, with the stylesheet, and
         * HeroBackground.svelte picks the answer up off window.__hero.
         */
        var dpr = Math.min(window.devicePixelRatio || 1, 1.5); // the cap the canvas is drawn at
        var want = 1.2 * dpr * Math.max(window.innerWidth, window.innerHeight);
        var pick = sources.find((s) => s.height >= want) || sources[sources.length - 1];
        window.__hero = {
            url: pick.url,
            blob: fetch(pick.url)
                .then((r) => (r.ok ? r.blob() : null))
                .catch(() => null), // the island fetches it the slow way if this failed
        };
    </script>
    <!-- After the hero script, which is on the critical path and this is not -->
    <script
        slot="head"
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(personSchema)}
    />
    <!-- Full-viewport hero section -->
    <section class="hero-section relative min-h-screen flex flex-col">
        <div class="absolute inset-0 z-[-1]">
            <HeroBackground client:only="svelte" />
        </div>
        <!-- Hero navbar -->
        <nav
            class="hero-nav mx-auto flex max-w-6xl w-full items-center justify-between px-6 md:px-10 pt-8 relative z-20"
        >
            <a href="/" class="text-lg sm:text-xl font-serif">aaron ye</a>
            <div class="flex items-center gap-6">
                <NavLinks currentPath="/" client:idle />
                <span class="hero-separator hidden md:inline">|</span>
                <Contacts />
                <MobileNav client:media="(max-width: 767px)" />
            </div>
        </nav>

        <!-- Centered name -->
        <div class="flex-1 flex items-center justify-center -mt-20">
            <h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-serif tracking-wide text-base">
                aaron ye
            </h1>
        </div>
    </section>

    <!-- About section -->
    <section id="about" class="relative bg-surface">
        <div class="flex justify-center max-w-4xl mx-auto px-6 md:px-10 py-16 md:py-32">
            <AboutSection />
        </div>
    </section>

    <!-- Projects section -->
    <section class="relative bg-surface-2">
        <div class="projects-scale max-w-7xl 3xl:max-w-[104rem] mx-auto px-6 md:px-16 py-16 md:py-28">
            <ProjectsSection />
        </div>
    </section>

    <!-- Guestbook section -->
    <section class="relative bg-surface">
        <div class="max-w-[72rem] mx-auto px-6 md:px-10 py-12 md:py-20">
            <h2 class="font-serif text-[2.5rem] font-normal text-accent mb-4">Guestbook</h2>
            <p class="text-lg text-base">
                Feel free to leave a message in my <a
                    href="/guestbook"
                    class="text-base underline decoration-line underline-offset-2 transition-colors duration-200 hover:decoration-base"
                    >guestbook</a
                >.
            </p>
        </div>
    </section>
</Layout>

<style is:global>
    body {
        background: transparent !important;
    }
</style>

<style>
    /* Override child component colors in the hero nav — these can't be done with inline Tailwind */
    .hero-nav :global(a) {
        color: var(--color-base) !important;
    }

    .hero-nav :global(a:hover) {
        color: var(--color-accent) !important;
    }

    .hero-nav :global(svg) {
        color: var(--color-base) !important;
    }

    .hero-nav :global(span),
    .hero-separator {
        color: var(--color-base);
    }

    /*
     * The project cards carry screen recordings of real applications, and a card is only 544px
     * wide at this container's default size, which renders the app's own text at around 5px.
     * Zooming the section is the same thing as the reader pressing ctrl-+ on it: the cards, their
     * text and the videos all come up together, and the browser picks a larger image candidate to
     * match. Only once there is room for it - 1280px of container at 1.2 needs 1536px of viewport.
     */
    @media (min-width: 1600px) {
        .projects-scale {
            zoom: 1.2;
        }
    }
</style>
