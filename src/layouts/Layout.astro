---
import "../styles/global.css";
import "@fontsource/figtree";
import "@fontsource/petrona/400.css";
// The two faces every page sets text in. They are named inside the stylesheet, so without these
// the browser cannot know it wants them until the stylesheet has been parsed.
import figtreeLatin from "@fontsource/figtree/files/figtree-latin-400-normal.woff2?url";
import petronaLatin from "@fontsource/petrona/files/petrona-latin-400-normal.woff2?url";
import Footer from "../components/Footer.astro";
import NavBar from "../components/NavBar.astro";

interface Props {
    hideHeader?: boolean;
    /** The tab and the search result heading. Pages pass their own; the site name is the default. */
    title?: string;
    /** The sentence a search result or a link preview shows below the title. */
    description?: string;
    /** Open Graph type: "article" for a blog post, "website" for everything else. */
    ogType?: "website" | "article";
    /** Keep the page out of search results. For pages that are errors or are private. */
    noindex?: boolean;
}

const SITE_NAME = "Aaron Ye";
const DEFAULT_DESCRIPTION =
    "Aaron Ye is a computer science student at the University of Waterloo who builds full-stack applications with a focus on backend systems.";

const {
    hideHeader = false,
    title = SITE_NAME,
    description = DEFAULT_DESCRIPTION,
    ogType = "website",
    noindex = false,
} = Astro.props;

// Astro.site is set in astro.config.mjs, so both of these are absolute. Crawlers and the link
// previews of other sites reject a relative one.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL("/og.png", Astro.site).href;

const env = import.meta.env.PUBLIC_ENV as string;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preload" as="font" type="font/woff2" href={figtreeLatin} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={petronaLatin} crossorigin />
        <meta name="generator" content={Astro.generator} />

        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content={SITE_NAME} />
        <meta name="theme-color" content="#f2f7f4" />
        <link rel="canonical" href={canonicalUrl} />
        {noindex && <meta name="robots" content="noindex, nofollow" />}

        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="aaron ye, over the green hero artwork of the site" />
        <meta property="og:locale" content="en_CA" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
        {
            env === "PROD" && (
                <>
                    <script
                        defer
                        src="https://umami.aaronye.dev/script.js"
                        data-website-id="080b93fa-53f1-4d87-bfef-1e57ea5cdb7c"
                    />
                    <script
                        defer
                        src="https://umami.aaronye.dev/recorder.js"
                        data-website-id="080b93fa-53f1-4d87-bfef-1e57ea5cdb7c"
                    />
                </>
            )
        }
        <slot name="head" />
    </head>
    <body class="bg-surface text-base font-sans">
        <div class="flex flex-col justify-between min-h-screen relative z-10">
            <div>
                {
                    hideHeader ? (
                        <slot />
                    ) : (
                        <div class="min-h-screen bg-surface">
                            <nav class="max-w-6xl mx-auto flex items-center justify-between px-6 md:px-10 py-8">
                                <NavBar currentPath={Astro.url.pathname} />
                            </nav>
                            <div class="h-px bg-line" />
                            <div class="max-w-6xl mx-auto px-6 md:px-10 pb-12">
                                <slot />
                            </div>
                        </div>
                    )
                }
            </div>
            <Footer />
        </div>
    </body>
</html>
