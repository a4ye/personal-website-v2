---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
// Card images are composed by scripts/project-art/compose.py
import dimeDefenderImg from "../assets/projects/dime-defender.jpg";
import eurekaHacksImg from "../assets/projects/eureka-hacks-2025.jpg";
import mrGooseImg from "../assets/projects/mr-goose.jpg";
import igniteAiImg from "../assets/projects/ignite-ai.jpg";
import gdtrisImg from "../assets/projects/gdtris.jpg";
import fernImg from "../assets/projects/fern.jpg";
import gdtrisVideo from "../assets/projects/gdtris.mp4";
import igniteAiVideo from "../assets/projects/ignite-ai.mp4";
import eurekaHacksVideo from "../assets/projects/eureka-hacks-2025.mp4";
import mrGooseVideo from "../assets/projects/mr-goose.mp4";
import dimeDefenderVideo from "../assets/projects/dime-defender.mp4";
import fernVideo from "../assets/projects/fern.mp4";
import type { ImageMetadata } from "astro";

interface Project {
    title: string;
    description: string;
    tech: string[];
    year: number;
    github?: string;
    live?: string;
    image: ImageMetadata;
    // Plays in place of the image while the card is hovered
    video?: string;
}

const projects: Project[] = [
    {
        title: "Fern",
        description:
            "A faster, smarter replacement for the job search spreadsheet. Paste a posting link and the company, role, location, and pay fill themselves in. Funnel, timeline, and Sankey views show where every application went.",
        tech: ["TypeScript", "Next.js", "PostgreSQL", "Better Auth", "Bun"],
        year: 2026,
        github: "https://github.com/a4ye/fern",
        live: "https://fern.aaronye.dev",
        image: fernImg,
        video: fernVideo,
    },
    {
        title: "Dime Defender",
        description:
            "A Chrome extension that creates an Ace Attorney–style debate between two AI lawyers to debate purchases at Amazon and Shopify checkout pages. Finalist @ Hack the North 2024.",
        tech: ["Plasmo", "JavaScript", "Svelte"],
        year: 2024,
        github: "https://github.com/aryanp05/hackthenorth24",
        live: "https://devpost.com/software/budget-defender",
        image: dimeDefenderImg,
        video: dimeDefenderVideo,
    },
    {
        title: "EurekaHACKS 2025 Website",
        description:
            "The website for the 2025 iteration of EurekaHACKS. Includes an application system, hacker dashboard, and admin dashboard.",
        tech: ["TypeScript", "Next.js", "PostgreSQL", "AWS"],
        year: 2025,
        github: "https://github.com/EurekaHackathon/EurekaHACKS-2025",
        live: "https://2025.eurekahacks.ca/",
        image: eurekaHacksImg,
        video: eurekaHacksVideo,
    },
    {
        title: "GDTris",
        description: "A modern Tetris game made in Godot and inspired by TETR.IO.",
        tech: ["Godot", "GDScript"],
        year: 2024,
        github: "https://github.com/a4ye/gdtris",
        live: "https://a4ye.github.io/gdtris/",
        image: gdtrisImg,
        video: gdtrisVideo,
    },
    {
        title: "Ignite AI",
        description:
            "A webapp inspired by Infinite Craft that lets people explore different career pathways. Honourable-mention @ NSBEHacks 2024.",
        tech: ["SvelteKit", "PocketBase"],
        year: 2024,
        github: "https://github.com/danielp1218/IgniteAI",
        live: "https://devpost.com/software/ignite-tkhjbw",
        image: igniteAiImg,
        video: igniteAiVideo,
    },
    {
        title: "Mr. Goose",
        description:
            "An AI-powered VSCode extension that assists beginners with coding while still encouraging learning through problem-solving. First place and best developer tool @ JAMHacks 2025.",
        tech: ["TypeScript", "VSCode Extension", "Elysia.js"],
        year: 2025,
        github: "https://github.com/a4ye/jamhacks-2025",
        image: mrGooseImg,
        video: mrGooseVideo,
    },
];
---

<section id="projects">
    <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-6 md:gap-12 mb-16">
        <div class="flex-1">
            <h2
                class="font-serif text-[2.5rem] md:text-[3.5rem] font-normal text-accent leading-[1.15] max-w-[28rem]"
            >
                Projects
            </h2>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-x-16 md:gap-y-12 3xl:gap-x-20">
        {
            projects.map((project, index) => (
                <div class:list={["relative", index % 2 === 1 && "md:mt-16"]} data-project-card>
                    <a
                        href={project.live || project.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group block no-underline"
                    >
                        <div class="relative overflow-hidden rounded-xl mb-6">
                            {/*
                             * AVIF at 60 measures the same fidelity as the WebP at 90 it replaces
                             * - 38.0 dB against 38.1 - for 56 KB a card instead of 134. Nothing
                             * is lost by asking for it: the hero photo is AVIF with no fallback,
                             * so a browser that cannot read one has no background either.
                             *
                             * Every card is below the fold, under a full-height hero and the about
                             * section, so none of them is worth fetching before the page is up.
                             */}
                            <Image
                                src={project.image}
                                alt={`Screenshot of ${project.title}`}
                                widths={[600, 900, 1200, 1600]}
                                sizes="(min-width: 130rem) 56rem, (min-width: 100rem) 41rem, (min-width: 768px) 36rem, 100vw"
                                format="avif"
                                quality={60}
                                class="w-full h-auto aspect-[4/3]"
                                loading="lazy"
                                decoding="async"
                            />
                            {project.video && (
                                <video
                                    src={project.video}
                                    class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-300 data-[playing]:opacity-100"
                                    muted
                                    loop
                                    playsinline
                                    preload="none"
                                    aria-hidden="true"
                                    tabindex="-1"
                                />
                            )}
                        </div>
                        <div class="flex justify-between items-center mb-2">
                            <span class="text-[0.9rem] tracking-[0.05em] text-muted">
                                {project.year}
                            </span>
                            <Icon
                                name="iconoir--arrow-up-right"
                                class="w-5 h-5 text-accent transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                                aria-hidden="true"
                            />
                        </div>
                        <h3 class="font-serif text-[2rem] font-normal text-accent mb-4">
                            {project.title}
                        </h3>
                    </a>
                    {project.video && (
                        /*
                         * A touch device has no hover, so the video needs a control. The badge
                         * is a sibling of the card link, not a child of it: a button inside an
                         * anchor is invalid, and a tap on it must not open the project. The
                         * overlay matches the image box - full card width at 4/3 - and passes
                         * taps through everywhere except on the badge itself, so the rest of
                         * the image still follows the link.
                         *
                         * The badge carries no text, so its name is the aria-label the script keeps
                         * in step with the state. A transparent ::before takes the circle past the
                         * 44px a thumb needs.
                         */
                        <div class="pointer-events-none absolute inset-x-0 top-0 aspect-[4/3] flex items-end p-3 pointer-fine:hidden">
                            <button
                                type="button"
                                data-video-toggle
                                data-state="idle"
                                data-title={project.title}
                                aria-pressed="false"
                                aria-label={`Play the ${project.title} demo`}
                                class="group/badge pointer-events-auto relative inline-flex items-center justify-center rounded-full bg-black/55 p-3 text-white backdrop-blur-sm transition-colors before:absolute before:-inset-1 before:content-[''] active:bg-black/70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                            >
                                <Icon
                                    name="tabler--player-play-filled"
                                    class="hidden w-4 h-4 group-data-[state=idle]/badge:block"
                                    aria-hidden="true"
                                />
                                <Icon
                                    name="eos-icons--loading"
                                    class="hidden w-4 h-4 group-data-[state=loading]/badge:block"
                                    aria-hidden="true"
                                />
                                <Icon
                                    name="tabler--player-pause-filled"
                                    class="hidden w-4 h-4 group-data-[state=playing]/badge:block"
                                    aria-hidden="true"
                                />
                            </button>
                        </div>
                    )}
                    <p class="text-[1.05rem] text-base leading-[1.7] mb-5">{project.description}</p>
                    <div class="flex flex-wrap gap-2.5">
                        {project.tech.map((t) => (
                            <span class="text-[0.8rem] py-1.5 px-3.5 border border-line rounded-md text-muted">
                                {t}
                            </span>
                        ))}
                    </div>
                </div>
            ))
        }
    </div>

    <hr class="mt-16 border-0 border-t border-line" />
</section>

<script>
    // Crossfade a card's image to its video: on hover where a pointer can hover, and on a tap of
    // the card's badge where it cannot.
    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    // One card plays at a time. Each card's own way to stop, so any card can stop the others.
    const stops = new Map<Element, () => void>();

    document.querySelectorAll<HTMLElement>("[data-project-card]").forEach((card) => {
        const video = card.querySelector("video");
        const link = card.querySelector("a");
        if (!video || !link) return;

        const badge = card.querySelector<HTMLButtonElement>("[data-video-toggle]");

        const setState = (state: "idle" | "loading" | "playing") => {
            if (!badge) return;
            badge.dataset.state = state;
            badge.setAttribute("aria-pressed", String(state !== "idle"));
            // The badge shows only an icon, so its name must say what the icon means
            const verb = state === "idle" ? "Play" : "Stop";
            badge.setAttribute("aria-label", `${verb} the ${badge.dataset.title} demo`);
        };

        const stop = () => {
            video.pause();
            delete video.dataset.playing;
            setState("idle");
        };
        stops.set(card, stop);

        const start = () => {
            stops.forEach((stopOther, other) => other !== card && stopOther());
            // A rejected play is a cancelled one: the badge goes back to its resting state
            video.play().catch(() => setState("idle"));
        };

        // Show the video only once frames are coming, so the image never flashes to black
        video.addEventListener("playing", () => {
            video.dataset.playing = "";
            setState("playing");
        });
        // Rewind after the fade out, so the next play starts from the beginning
        video.addEventListener("transitionend", () => {
            if (!("playing" in video.dataset)) video.currentTime = 0;
        });

        const hoverStart = () => {
            if (!canHover.matches || reduceMotion.matches) return;
            start();
        };
        link.addEventListener("pointerenter", hoverStart);
        link.addEventListener("pointerleave", stop);
        link.addEventListener("focus", hoverStart);
        link.addEventListener("blur", stop);

        // The badge is the touch path. A tap is a request for the video, so reduced motion does
        // not block it; the fade is the only motion and it is short. The video holds preload="none",
        // so this tap is what starts the download - the spinner covers the wait for the first frame.
        badge?.addEventListener("click", () => {
            if (badge.dataset.state === "idle") {
                setState("loading");
                start();
            } else {
                stop();
            }
        });
    });

    // A video the reader has scrolled away from, or a tab they have left, is not being watched
    const offscreen = new IntersectionObserver((entries) => {
        for (const entry of entries) if (!entry.isIntersecting) stops.get(entry.target)?.();
    });
    stops.forEach((_, card) => offscreen.observe(card));
    document.addEventListener("visibilitychange", () => {
        if (document.hidden) stops.forEach((stop) => stop());
    });
</script>
