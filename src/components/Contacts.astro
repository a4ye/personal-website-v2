---
import { Icon } from "astro-icon/components";
import Tooltip from "./Tooltip.svelte";
---

<div class="flex sm:justify-end gap-4">
    <Tooltip label="GitHub" client:idle>
        <a
            aria-label="Github"
            href="https://github.com/a4ye/"
            data-umami-event="contact-click"
            data-umami-event-channel="github"
            target="_blank"
            rel="noreferrer noopener"
        >
            <Icon
                name="lucide--github"
                class="w-4 h-4 text-accent hover:text-base transition-colors duration-200"
            />
        </a>
    </Tooltip>
    <Tooltip label="LinkedIn" client:idle>
        <a
            aria-label="LinkedIn"
            href="https://www.linkedin.com/in/aaron--ye"
            data-umami-event="contact-click"
            data-umami-event-channel="linkedin"
            target="_blank"
            rel="noreferrer noopener"
        >
            <Icon
                name="lucide--linkedin"
                class="w-4 h-4 text-accent hover:text-base transition-colors duration-200"
            />
        </a>
    </Tooltip>
    <Tooltip label="X" client:idle>
        <a
            aria-label="X"
            href="https://x.com/aaronye1001"
            data-umami-event="contact-click"
            data-umami-event-channel="x"
            target="_blank"
            rel="noreferrer noopener"
        >
            <Icon
                name="ri--twitter-x-line"
                class="w-4 h-4 text-accent hover:text-base transition-colors duration-200"
            />
        </a>
    </Tooltip>
    <Tooltip label="Email" client:idle>
        <a
            aria-label="Email"
            href="mailto:aaronye1001@gmail.com"
            data-umami-event="contact-click"
            data-umami-event-channel="email"
        >
            <Icon
                name="lucide--mail"
                class="w-4 h-4 text-accent hover:text-base transition-colors duration-200"
            />
        </a>
    </Tooltip>
    <Tooltip label="Resume" client:idle>
        <a
            aria-label="Resume"
            href="/resume"
            data-umami-event="resume-open"
            target="_blank"
            rel="noreferrer noopener"
        >
            <Icon
                name="lucide--file-text"
                class="w-4 h-4 text-accent hover:text-base transition-colors duration-200"
            />
        </a>
    </Tooltip>
</div>
